      "name": "Set user override",
      "description": "Apply a TIMED airflow override (boost/off/etc) that auto-resumes. For a persistent fan speed use the fan entity instead.",
      "fields": {
        "mode": {
          "name": "Mode",
          "description": "Airflow mode to apply."
        },
        "duration": {
          "name": "Duration",
          "description": "How long the override should run before auto-resuming."
        },
        "device_id": {
          "name": "Device",
          "description": "Required only if multiple Vent-Axia Econiq units are configured."
        }
      }
    },
    "cancel_user_override": {
      "name": "Cancel user override",
      "description": "Cancel the active override and resume the unit's schedule / default airflow.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Required only if multiple Vent-Axia Econiq units are configured."
        }
      }
    },
    "set_bypass": {
      "name": "Set summer bypass",
      "description": "Configure the summer-bypass damper. Any omitted field keeps its current value.",
      "fields": {
        "mode": {
          "name": "Mode",
          "description": "Summer-bypass mode (off / normal / evening / night, with modulation variants)."
        },
        "fan_mode": {
          "name": "Fan speed",
          "description": "Airflow preset to run while the bypass is active."
        },
        "ect": {
          "name": "Outdoor threshold (°C)",
          "description": "ExternalComfortTemperature. The Connect app caps this at 20 °C; HA allows higher for free-cooling."
        },
        "ict": {
          "name": "Indoor target (°C)",
          "description": "RoomComfortTemperature — the indoor comfort target."
        },
        "device_id": {
          "name": "Device",
          "description": "Required only if multiple Vent-Axia Econiq units are configured."
        }
      }
    }
